{
  "compilerOptions": {
    "target": "ES2022",
    "module": "none",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outFile": "build/stats.js",
    "removeComments": true
  },
  "files": [
    "src/types.ts",
    "src/adapter.ts",
    "src/live_streams.ts",
    "src/session_timeline.ts",
    "src/session_history.ts",
    "src/host_metrics.ts",
    "src/history.ts",
    "src/history_settings.ts",
    "src/main.ts"
  ]
}
